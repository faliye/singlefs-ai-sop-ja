C commit-publish
(* generated-from: templates/litmus/commit-publish.litmus sha256:15d1491bb05768658df3fc4dc55bbc20232a2c332e228bc4a23b17140717c6e6 *)

(*
 * トランザクション・コミットの公開順序：先に新しいブロックの内容を書き、
 * そのあとでそれを指すスーパーブロックを書く。
 * 悪い結果 = 読み手が新しい generation を見たのに、古いブロック内容を読む
 *            （スーパーブロックが、内容がまだ見えていないブロックを指す
 *             → マウント時にゴミを読む）。
 *
 * これは COW ファイルシステムで最も基本的な順序であり、
 * 「コミットは原子的である」の全体がこの上に載っている。
 *
 * P0 = 書き手（トランザクションをコミットする）。P1 = 読み手（マウント、または並行読み）。
 *
 * singlefs-expect: Never
 * singlefs-models: none —— テンプレート：Never と対照群の組み方を示すだけで、どのコードにも対応しない。
 *   この順序を実装するコードをプロジェクトが書いたら、この行を <リポジトリ内パス>::<関数名> に替え、
 *   このファイルを読むテストを書く。
 *)

{}

P0(int *blk, int *gen)
{
	WRITE_ONCE(*blk, 1);
	smp_wmb();
	WRITE_ONCE(*gen, 1);
}

P1(int *blk, int *gen)
{
	int r0;
	int r1;

	r0 = READ_ONCE(*gen);
	smp_rmb();
	r1 = READ_ONCE(*blk);
}

exists (1:r0=1 /\ 1:r1=0)
